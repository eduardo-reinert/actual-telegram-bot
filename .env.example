# --- Actual Budget server ---
ACTUAL_SERVER_URL=http://localhost:5006
ACTUAL_PASSWORD=your-server-password
# Settings -> Show advanced settings -> Sync ID
ACTUAL_SYNC_ID=00000000-0000-0000-0000-000000000000
# Only if the budget has end-to-end encryption enabled:
ACTUAL_E2E_PASSWORD=
ACTUAL_DATA_DIR=./data/actual

# --- Telegram ---
# Token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-token
# Comma-separated numeric Telegram user IDs allowed to use the bot.
# Don't know yours? Start the bot, send /id to it, then fill this in and restart.
ALLOWED_USER_IDS=

# --- Behaviour ---
DEFAULT_ACCOUNT=Checking
# true = run Actual rules (payee -> category automation), like a bank import
APPLY_RULES=true
CURRENCY=BRL
LOCALE=pt-BR
